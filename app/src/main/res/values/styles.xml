<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#0B0F16</item>
        <item name="android:navigationBarColor">#0B0F16</item>
        <item name="android:colorAccent">#4B6DFF</item>
        <item name="android:colorPrimary">#4B6DFF</item>
        <item name="android:windowBackground">#0B0F16</item>
        <item name="android:textColor">#F0F3F8</item>
        <item name="android:textColorHint">#8B95A8</item>
        <item name="android:editTextColor">#F0F3F8</item>
        <item name="android:alertDialogTheme">@style/MyPlanDialog</item>
        <item name="android:datePickerDialogTheme">@style/MyPlanDialog</item>
        <item name="android:timePickerDialogTheme">@style/MyPlanDialog</item>
    </style>
    <style name="MyPlanDialog" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.55</item>
        <item name="android:colorAccent">#4B6DFF</item>
        <item name="android:textColorPrimary">#F0F3F8</item>
        <item name="android:textColorSecondary">#8B95A8</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/MyPlanDialogButton</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/MyPlanDialogButton</item>
        <item name="android:buttonBarNeutralButtonStyle">@style/MyPlanDialogButton</item>
        <item name="android:windowTitleStyle">@style/MyPlanDialogTitle</item>
    </style>
    <style name="MyPlanDialogTitle" parent="android:TextAppearance.Material.Title">
        <item name="android:textColor">#F0F3F8</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="MyPlanDialogButton" parent="android:Widget.Material.Button.Borderless">
        <item name="android:textColor">#4B6DFF</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
